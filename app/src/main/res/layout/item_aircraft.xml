<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layout_aircraft_item"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="4dp"
    android:background="@drawable/bg_aircraft_item"
    android:clickable="true"
    android:focusable="true"
    android:orientation="horizontal"
    android:padding="12dp">

    <!-- Left: Aircraft Icon in Circular Altitude Badge -->
    <FrameLayout
        android:id="@+id/container_icon"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="center_vertical"
        android:layout_marginEnd="12dp"
        android:background="@drawable/bg_hud_tile">

        <ImageView
            android:id="@+id/iv_aircraft_heading"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_gravity="center"
            android:contentDescription="Aircraft"
            android:src="@drawable/ic_airplane" />
    </FrameLayout>

    <!-- Center: Callsign, Type, Route, and Flight Telemetry -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Callsign, Type Badge, and Airline -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_callsign"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/mitr_bold"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                tools:text="UAL123" />

            <TextView
                android:id="@+id/tv_aircraft_type"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_aircraft_type_badge"
                android:fontFamily="@font/mitr_regular"
                android:paddingHorizontal="5dp"
                android:paddingVertical="1dp"
                android:textColor="@color/text_secondary"
                android:textSize="10sp"
                tools:text="B789" />

            <TextView
                android:id="@+id/tv_airline"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="@font/mitr_regular"
                android:maxLines="1"
                android:textColor="@color/text_muted"
                android:textSize="11sp"
                tools:text="United Airlines" />
        </LinearLayout>

        <!-- Route Row -->
        <TextView
            android:id="@+id/tv_route"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:fontFamily="@font/mitr_regular"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            tools:text="JFK ➔ LAX" />

        <!-- Telemetry Row: Altitude, Speed, Heading -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Altitude with Climb/Descend icon -->
            <ImageView
                android:id="@+id/iv_vertical_rate"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:contentDescription="Vertical rate"
                android:src="@drawable/ic_climb" />

            <TextView
                android:id="@+id/tv_altitude"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="3dp"
                android:fontFamily="@font/mitr_bold"
                android:textColor="@color/text_primary"
                android:textSize="11sp"
                tools:text="36,000 ft" />

            <!-- Divider dot -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="6dp"
                android:text="•"
                android:textColor="@color/text_muted"
                android:textSize="10sp" />

            <!-- Speed -->
            <ImageView
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:contentDescription="Speed"
                android:src="@drawable/ic_speed" />

            <TextView
                android:id="@+id/tv_speed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="3dp"
                android:fontFamily="@font/mitr_regular"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                tools:text="480 kts" />

            <!-- Divider dot -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="6dp"
                android:text="•"
                android:textColor="@color/text_muted"
                android:textSize="10sp" />

            <!-- Heading -->
            <TextView
                android:id="@+id/tv_heading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/mitr_regular"
                android:textColor="@color/text_muted"
                android:textSize="11sp"
                tools:text="270°" />
        </LinearLayout>
    </LinearLayout>

    <!-- Right: Distance & Squawk Badge -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:layout_marginStart="8dp"
        android:gravity="end"
        android:orientation="vertical">

        <!-- Distance -->
        <TextView
            android:id="@+id/tv_distance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/mitr_bold"
            android:textColor="@color/text_accent"
            android:textSize="13sp"
            tools:text="14.2 nmi" />

        <!-- Squawk Code Pill -->
        <TextView
            android:id="@+id/tv_squawk"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_aircraft_type_badge"
            android:fontFamily="@font/mitr_regular"
            android:paddingHorizontal="6dp"
            android:paddingVertical="1dp"
            android:textColor="@color/text_muted"
            android:textSize="10sp"
            tools:text="SQ 1200" />
    </LinearLayout>
</LinearLayout>
